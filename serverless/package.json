    "@vercel/queue": "^0.11.0",
    "@vercel/sandbox": "^3.9.1",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^4.0.0"
  }
}
